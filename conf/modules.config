/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

process {

    /* publishDir = [
    path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    //path: { "${params.outdir}"},
    mode: params.publish_dir_mode,
    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ] */
    // In your global configuration section:
    publishDir = [path: {
        // If the process defines ext.dir, use it. Otherwise, use the lowercase process name.
        task.ext.dir
            ? "${params.outdir}/${task.ext.dir}"
            : "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}"
    }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]


    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    seek references
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
     */
    withName: MASH_SCREEN {
        ext.args = "-i ${params.mashthreshold} -w -v ${params.max_p_value}"
        ext.dir = 'seekref'
    }
    withName: MASHFILTER {
        ext.args = "-m ${params.min_hash_coverage} -a ${params.min_median_multiplicity}"
        ext.dir = 'seekref'
    }
    withName: SEQKIT_GREP {
        ext.prefix = { "${meta.id}-reference" }
        ext.dir = 'seekref'
    }
    withName: SAMTOOLS_FAIDX {
        ext.dir = 'seekref'
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Mapping
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
     */
    withName: MINIBWA_INDEX {
        ext.prefix = { "${meta.id}.minibwa" }
        publishDir = [enabled: false]
    }
    withName: MINIBWA_MAP {
        ext.prefix = { "${meta.id}.minibwa" }
        ext.dir = 'mapping'
    }
    withName: MINIMAP2_ALIGN {
        //ext.args = " --cs --MD -aLx map-ont --secondary=no"
        // secondary alignment is needed for influenza virus because of its segmented genome, a single read can map to multiple segments
        ext.args = " --cs --MD -aLx map-ont"
        ext.prefix = { "${meta.id}.minimap2" }
        ext.dir = 'mapping'
    }

    withName: SAMTOOLS_VIEW_ILLUMINA {
        ext.prefix = { "${meta.id}.filter" }
        //ext.args = " -F 3844 --write-index "
        // should keep duplicates because of amplicon data
        ext.args = " -F 2820 --write-index "
        ext.dir = 'mapping'
    }

    withName: SAMTOOLS_VIEW_NANOPORE {
        ext.prefix = { "${meta.id}.filter" }
        //ext.args = " -F 3844 --write-index "
        // should keep duplicates because of amplicon data
        // should keep supplimentary alignment becaues mapping can split a single long reds into two pieces
        ext.args = " -F 772 --write-index "
        ext.dir = 'mapping'
    }
    withName: SAMTOOLS_COVERAGE {
        ext.prefix = { "${meta.id}.coverage" }
        // do not do any quality filtering for minimum mapping quality -q,
        //it can filter out the reads with multiple mapping locations,
        //which is common for influenza virus because of its segmented genome
        //ext.args = " -d 0 -q 0 -Q 0"
        ext.args = " -d 0 -q 0 -Q 10"
        ext.dir = 'mapping'
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    variants
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
     */
    withName: FREEBAYES {
        ext.args = ["--ploidy 1", "--haplotype-length -1", "--min-mapping-quality 20", "--min-base-quality 30", "--min-alternate-fraction 0.05", "--min-alternate-count 2", "--min-alternate-total 3", "--pooled-continuous"].join(' ').trim()
        ext.prefix = { "${meta.id}.freebayes" }
        ext.dir = 'variants'
    }
    withName: CLAIR3 {
        //orginal args
        //ext.args = ["--platform=\"ont\"", "--haploid_precise", "--enable_long_indel", "--keep_iupac_bases", "--include_all_ctgs", " --no_phasing_for_fa", "--min_coverage=${params.mindepth}", "--min_mq=30", "--base_err=0.05", "--var_pct_full=1", "--ref_pct_full=1", "--var_pct_phasing=1"].join(' ').trim()
        ext.args = ["--platform=\"ont\"", "--haploid_precise", "--enable_long_indel", "--keep_iupac_bases", "--include_all_ctgs", " --no_phasing_for_fa", "--min_coverage=${params.mindepth}", "--min_mq=30", "--var_pct_full=1", "--ref_pct_full=1", "--var_pct_phasing=1", "--enable_variant_calling_at_sequence_head_and_tail"].join(' ').trim()


        //nf-flu from cifa parameters
        //ext.args = '--haploid_sensitive --enable_long_indel --keep_iupac_bases --include_all_ctgs --var_pct_phasing=1 --var_pct_full=1 --ref_pct_full=1 --platform="ont" --enable_variant_calling_at_sequence_head_and_tail'

        ext.prefix = { "${meta.id}.clair3" }
        ext.dir = 'variants'
    }
    withName: BCF_FILTER {
        ext.dir = 'variants'
    }
    withName: BCFTOOLS_STATS {
        ext.prefix = { "${meta.id}.bcftools_filt" }
        ext.dir = 'variants'
    }

    //produce bed file with low depth region of the reference
    withName: BEDTOOLS_GENOMECOV {
        ext.args = "-bga  | awk \'\$4 < ${params.mindepth}\' "
        ext.prefix = { "${meta.id}.perbase_depth_low" }
        ext.dir = "mapping"
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    consensus
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
     */

    withName: BCF_CONSENSUS {
        ext.dir = "consensus"
    }
    withName: SEQKIT_FX2TAB {
        ext.args = '--only-id --name --length -C ATCG -C RYSWKMBDHV -C N -H'
        ext.suffix = 'txt'
        //ext.prefix = { "${meta.id}.bcftools_consensus_stats" }
        ext.prefix = { "${meta.id}.consensus_stats" }
        ext.dir = "consensus"
    }


    withName: CONSENSUS_FILTER_AND_RENAME {
        ext.prefix = { "${meta.id}.consensus" }
        ext.dir = "consensus"
        //ext.args = "--maxambigs 0.20"
        //change to 50%, this is the cutoff NML using
        ext.args = "--maxambigs ${params.consensus_maxambigs}"
    }

    withName: CONCAT_CONSENSUS {
        ext.prefix = { "all_consensus" }
        //ext.dir = 'report'
        publishDir = [
            [
                path: { "${params.outdir}/report" },
                mode: params.publish_dir_mode,
            ],
            [
                path: { "${params.outdir}/consensus" },
                mode: params.publish_dir_mode,
            ],
        ]
    }
    withName: CONSENSUS_REPORT {

        ext.dir = 'consensus'
    }
    withName: CONCAT_CONSENSUS_REPORT {
        //ext.dir = 'report'
        publishDir = [
            [
                path: { "${params.outdir}/report" },
                mode: params.publish_dir_mode,
            ],
            [
                path: { "${params.outdir}/consensus" },
                mode: params.publish_dir_mode,
            ],
        ]
    }
    /*
    ----------------------------------------------------------------------------------------
    classifier: nextclade
    ----------------------------------------------------------------------------------------
     */

    withName: BLAST_BLASTN {
        ext.args = "-max_target_seqs ${params.max_target_seqs} -outfmt '6 std qlen slen qcovs' -perc_identity ${params.min_blast_ident} -qcov_hsp_perc ${params.qcov_hsp_perc} -evalue ${params.evalue}"
        //q cover filter
        //ext.args2 = " ${params.min_blast_cov} "

        publishDir = [enabled: false]
    }
    withName: CSVTK_ADD_HEADER_BLASTN {
        ext.prefix = { "${meta.id}.blast" }
        ext.args = "-t -H "
        ext.dir = "typing"
    }
    withName: PROCESS_BLAST {
        //ext.prefix = { "${meta.id}.subtype" }
        //ext.dir = "typing"
        publishDir = [
            [
                path: { "${params.outdir}/report" },
                mode: params.publish_dir_mode,
            ],
            [
                path: { "${params.outdir}/typing" },
                mode: params.publish_dir_mode,
            ],
        ]
    }
    withName: VADR_SCAN {
        ext.dir = "vadr"
        ext.prefix = { "${meta.id}" }
        ext.args = ""
    }

    withName: NEXTCLADE_RUN {
        ext.prefix = { "${meta.id}.nextclade" }
        ext.dir = 'nextclade/raw_output'
    }

    withName: AGG_NEXTCLADE_HA_NA {
        //ext.args = '-d ";"'
        //ext.dir = 'nextclade'
        publishDir = [
            [
                path: { "${params.outdir}/report" },
                mode: params.publish_dir_mode,
            ],
            [
                path: { "${params.outdir}/nextclade" },
                mode: params.publish_dir_mode,
            ],
        ]
    }
    withName: NEXTCLADE_DATASET_GET {
        ext.dir = "nextclade/datasets"
    }

    /*
    ----------------------------------------------------------------------------------------
    report
    ----------------------------------------------------------------------------------------
     */

    withName: CREATE_SUMMARY_REPORT {
        ext.dir = 'report'
    }
}
